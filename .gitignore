# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Sensitive var files
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Key files & Secrets
*.pem
*.key
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db
